 char? FirstChar(string word)
    {
        Dictionary<char,int> mydih = new Dictionary<char,int>();
        foreach(char c in word)
        {
            if(!mydih.TryGetValue(c,out int i))
            {
                mydih[c] = 1;
            }
            else{mydih[c]++;}
        }

        foreach(char c in word)
        {
            if(mydih[c] == 1){return c;}
        }
        return null;
    }
