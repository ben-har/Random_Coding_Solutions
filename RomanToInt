public int RomanToInt(string s) {
        int result = 0;
        
        // check the char next to the current index if it is what were look forward move the index forward or add base
        for(int i = 0; i < s.Length; i++)
        {
            switch (s[i])
            {
                case 'I':
                    if(i + 1 < s.Length && s[i + 1] == 'V')
                    {
                        result += 4;
                        i++;
                    }
                    else if(i + 1 < s.Length && s[i + 1] == 'X')
                    {
                       result += 9;
                       i++; 
                    }
                    else{result++;}
                    break;
                case 'V':
                    result += 5;
                    break;
                case 'X':
                    if(i + 1 < s.Length && s[i + 1] == 'L')
                    {
                        result += 40;
                        i++;
                    }
                    else if(i + 1 < s.Length && s[i + 1] == 'C')
                    {
                       result += 90;
                       i++; 
                    }
                    else{result += 10;}
                    break;
                case 'L':
                    result += 50;
                    break;
                case 'C':
                    if(i + 1 < s.Length && s[i + 1] == 'D')
                    {
                        result += 400;
                        i++;
                    }
                    else if(i + 1 < s.Length && s[i + 1] == 'M')
                    {
                       result += 900;
                       i++; 
                    }
                    else{result += 100;}
                    break;
                case 'D':
                    result += 500;
                    break;
                case 'M':
                    result += 1000;
                    break;
            }
        }
        return result;
    }
