using System;
using System.Text;
class Program
{
	public static string FindNemo(string sentence)
	{
		int counter = 1;
		StringBuilder sb = new StringBuilder();
		for(int i = 0; i < sentence.Length; i++)
		{
			if(sentence[i] == ' ')
			{
				if(sb.ToString() == "Nemo")
				{
					return $"I found Nemo at {counter}!";
				}
				else
				{
					counter++;
					sb.Clear();
				}
			}
			else 
			{
				sb.Append(sentence[i]);
			}
		}
		return "I can't find Nemo :(";
	}
}
