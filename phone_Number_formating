using System.Text;
public class Program 
{
    public static string FormatPhoneNumber(int[] numbers) 
    {
      StringBuilder sb = new StringBuilder();
			sb.Append('(');
			for(int i = 0; i < numbers.Length; i++)
			{
				switch(i)
				{
					default: 
						sb.Append(numbers[i].ToString());
						break;
					case 2:
						sb.Append(numbers[i].ToString());
						sb.Append(')');
						break;
					case 3:
						sb.Append(' ');
						sb.Append(numbers[i].ToString());
						break;
					case 6:
						sb.Append('-');
						sb.Append(numbers[i].ToString());
						break;
				}
			}
			return sb.ToString();
    }
}		
