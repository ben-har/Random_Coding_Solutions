public int RemoveElement(int[] nums, int val) {
        int j = nums.Length - 1;
		if(nums.Length == 1 && nums[0] == val)
        {
            nums = new int[]{};
            return 0;
        }

        for(int i = 0; i <= nums.Length; i++)
		{
			while(j >= i && nums[j] == val)
			{
				j--;
			}
			if(j < i){break;}
			if(nums[i] == val)
			{
				int temp = nums[i];
				nums[i] = nums[j];
				nums[j] = temp;
				
			}
			
		}
        return ++j;
    }
